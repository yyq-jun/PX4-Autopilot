#!/bin/sh
#
# Gazebo SITL – x500 (X-Quad, CW-CW-CCW-CCW)
#

. ${R}etc/init.d/rc.mc_defaults

# ────── Simulator / Model ──────
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}

param set-default SIM_GZ_EN 1            # enable gz bridge

# ────── Control Allocator ──────
param set-default CA_AIRFRAME 0          # custom
param set-default CA_ROTOR_COUNT 4

# Body 座標 (+X front, +Y right, +Z down)
# index 0 : front-right  (+X, +Y)  CW → KM −
param set-default CA_ROTOR0_PX  0.224
param set-default CA_ROTOR0_PY  0.151
param set-default CA_ROTOR0_KM -0.05

# index 1 : rear-left   (−X, -Y)  CW → KM −
param set-default CA_ROTOR1_PX -0.224
param set-default CA_ROTOR1_PY -0.151
param set-default CA_ROTOR1_KM -0.05

# index 2 : front-left  (+X, -Y)  CCW → KM ＋
param set-default CA_ROTOR2_PX  0.224
param set-default CA_ROTOR2_PY -0.151
param set-default CA_ROTOR2_KM  0.05

# index 3 : rear-right  (−X, +Y) CCW → KM ＋
param set-default CA_ROTOR3_PX -0.224
param set-default CA_ROTOR3_PY  0.151
param set-default CA_ROTOR3_KM  0.05

# ────── ESC (uORB actuator controls → MotorModel) ──────
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

# velocity command range [rad/s]
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150
param set-default SIM_GZ_EC_MAX1 2020
param set-default SIM_GZ_EC_MAX2 2020
param set-default SIM_GZ_EC_MAX3 2020
param set-default SIM_GZ_EC_MAX4 2020

# ────── MC position controller初期値 ──────
param set-default MPC_THR_HOVER 0.50     # 後でログを見て再調整
param set-default NAV_DLL_ACT    2       # datalink loss action

# スクリプト終了
